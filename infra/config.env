# Configuración compartida (sin secretos). Uso: export AWS_PROFILE=prometeo && source infra/config.env
export REGION=us-east-1
export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION=us-east-1
export PROJECT=prometeo-hack
# ID de modelo o de perfil de inferencia de Bedrock. Se llena con la salida de infra/00_check.sh, nunca de memoria.
export MODEL_ID=""
